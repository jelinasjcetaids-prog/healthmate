}

/* ═══ TOOL 1: HEALTH TIME MACHINE ════════════════════════════ */
function simulateFuture() {
  const btn   = document.getElementById('sim-btn');
  btn.innerHTML = '<span class="spinner"></span> Calculating...';
  btn.disabled = true;

  setTimeout(() => {
    const age    = parseInt(document.getElementById('ht-age').value)    || 30;
    const weight = parseInt(document.getElementById('ht-weight').value) || 70;
    const sleep  = parseInt(document.getElementById('ht-sleep').value);
    const stress = parseInt(document.getElementById('ht-stress').value);

    // ── Score algorithm ──────────────────────────────────────
    let score = 100;

    // Age factor
    if (age > 60) score -= 12;
    else if (age > 45) score -= 7;
    else if (age > 35) score -= 3;

    // BMI (rough) — using weight only as proxy
    if (weight > 100) score -= 12;
    else if (weight > 85) score -= 6;
    else if (weight < 45) score -= 5;

    // Sleep
    if (sleep < 5)      score -= 18;
    else if (sleep < 7) score -= 8;
    else if (sleep > 9) score -= 4;

    // Exercise
    const exMap = { none: -18, low: -8, moderate: 0, high: 5 };
    score += (exMap[selectedExercise] || 0);

    // Food
    const foodMap = { healthy: 5, average: -4, unhealthy: -16 };
    score += (foodMap[selectedFood] || 0);

    // Stress
    score -= Math.round((stress - 1) * 2.2);

    const currentScore = Math.max(15, Math.min(99, score));

    // Future (10yr projection — decline depends on habits)
    const habitPenalty = (exMap[selectedExercise] < 0 ? 6 : 0)
                       + (foodMap[selectedFood]   < 0 ? 6 : 0)
                       + (sleep < 7 ? 5 : 0)
                       + (stress > 7 ? 5 : 0);
    const futureScore  = Math.max(10, currentScore - habitPenalty - Math.round(age * 0.05));

    // Improvement tips & improved score
    const tips = [];
    let improvement = 0;
    if (sleep < 7)                         { tips.push({ icon:'🌙', text:'Increase sleep to at least 7–8 hours per night.' }); improvement += 8; }
    if (selectedExercise === 'none')       { tips.push({ icon:'🏃', text:'Start exercising at least 3 times a week for 30 minutes.' }); improvement += 10; }
    else if (selectedExercise === 'low')   { tips.push({ icon:'🏃', text:'Increase exercise frequency to moderate level for better results.' }); improvement += 5; }
    if (selectedFood === 'unhealthy')      { tips.push({ icon:'🥗', text:'Replace processed food with fruits, vegetables, and whole grains.' }); improvement += 10; }
    else if (selectedFood === 'average')   { tips.push({ icon:'🥗', text:'Add more fresh vegetables and reduce sugar intake.' }); improvement += 4; }
    if (stress > 7)                        { tips.push({ icon:'🧘', text:'Practice relaxation techniques: deep breathing, yoga, or meditation.' }); improvement += 7; }
    else if (stress > 5)                   { tips.push({ icon:'🧘', text:'Manage stress with short walks or mindfulness exercises.' }); improvement += 3; }
    if (weight > 90)                       { tips.push({ icon:'⚖️', text:'Work towards a healthy weight through diet and moderate exercise.' }); improvement += 5; }
    if (age > 40)                          { tips.push({ icon:'🩺', text:'Schedule annual health check-ups including BP, blood sugar, and cholesterol.' }); improvement += 3; }
    if (tips.length === 0)                 { tips.push({ icon:'🌟', text:'Excellent lifestyle! Keep maintaining your healthy habits.' }); }

    const improvedScore = Math.min(99, futureScore + improvement);

    // Risk level
    let risk, riskClass;
    if (futureScore >= 70)     { risk = 'Low Risk';    riskClass = 'risk-low'; }
    else if (futureScore >= 50){ risk = 'Medium Risk'; riskClass = 'risk-medium'; }
    else                       { risk = 'High Risk';   riskClass = 'risk-high'; }

    // ── Render ───────────────────────────────────────────────
    document.getElementById('current-score').textContent = currentScore;
    document.getElementById('future-score').textContent  = futureScore;
    document.getElementById('improved-score').textContent= improvedScore;

    const riskBadge = document.getElementById('risk-badge');
    riskBadge.textContent = risk;
    riskBadge.className   = 'risk-badge ' + riskClass;

    setTimeout(() => {
      document.getElementById('current-bar').style.width = currentScore + '%';
      document.getElementById('future-bar').style.width  = futureScore + '%';
      const col = futureScore >= 70 ? 'var(--accent)' : futureScore >= 50 ? '#f59e0b' : 'var(--accent2)';
      document.getElementById('future-bar').style.background = col;
      document.getElementById('future-score').style.color    = col;
    }, 100);

    const tipsHTML = tips.map(t => `
      <div class="tip-item">
        <span class="tip-icon">${t.icon}</span>
        <span>${t.text}</span>
      </div>`).join('');
    document.getElementById('tips-container').innerHTML = tipsHTML;

    document.getElementById('ht-placeholder').style.display = 'none';
    document.getElementById('ht-output').style.display      = 'block';

    btn.innerHTML = '<i class="bi bi-lightning-charge-fill"></i> Simulate Future Health';
    btn.disabled  = false;
  }, 900);
}

