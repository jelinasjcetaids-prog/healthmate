      <i class="bi bi-heart-pulse" style="font-size:3rem;opacity:.3"></i>
      <p class="mt-3" style="font-size:.9rem">Select symptoms and press <strong>Analyse</strong> to see results.</p>
    </div>`;
}

function checkSymptoms() {
  const selected = [...document.querySelectorAll('.symptom-chip.selected')].map(c => c.dataset.symptom);
  if (selected.length === 0) {
    alert('Please select at least one symptom.');
    return;
  }

  const matches = SYMPTOM_RULES
    .map(rule => {
      const overlap = rule.conditions.filter(c => selected.includes(c));
      return { ...rule, matched: overlap.length, matchedSymptoms: overlap };
    })
    .filter(r => r.matched >= r.match)
    .sort((a, b) => b.matched - a.matched)
    .slice(0, 3);

  const actionStyles = {
    emergency: 'action-emergency',
    doctor:    'action-doctor',
    self:      'action-self'
  };
  const actionIcons = { emergency: 'bi-exclamation-triangle-fill', doctor: 'bi-hospital', self: 'bi-house-heart' };

  let html = `<div style="font-weight:700;margin-bottom:14px;font-size:.92rem">
    <i class="bi bi-clipboard2-pulse" style="color:var(--primary)"></i>
    Possible Conditions for: <span style="color:var(--primary)">${selected.join(', ')}</span>
  </div>`;

  if (matches.length === 0) {
    html += `<div class="diagnosis-card"><p style="font-size:.88rem;color:var(--text-soft)">No strong pattern found. If symptoms persist, please consult a doctor.</p></div>`;
  } else {
    matches.forEach(m => {
      html += `
      <div class="diagnosis-card ${actionStyles[m.action]}">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <span style="font-size:1.3rem">${m.icon}</span>
            <strong style="margin-left:6px;font-size:.95rem">${m.name}</strong>
          </div>
          <span class="risk-badge ${m.severity.includes('High') ? 'risk-high' : m.severity.includes('Low') ? 'risk-low' : 'risk-medium'}">
            ${m.severity} Severity
          </span>
        </div>
        <p style="font-size:.82rem;margin-top:8px;margin-bottom:6px;opacity:.8">Matched symptoms: ${m.matchedSymptoms.join(', ')}</p>
        <div class="d-flex align-items-center gap-2 mt-2" style="font-size:.85rem;font-weight:600">
          <i class="bi ${actionIcons[m.action]}"></i> ${m.actionText}
        </div>
      </div>`;
    });
  }

  html += `<div style="font-size:.75rem;color:var(--text-soft);margin-top:8px">
    ⚠️ This is an informational tool only. It does not replace professional medical diagnosis.
  </div>`;

  document.getElementById('symptom-output').innerHTML = html;
}

/* ═══ TOOL 3: PRESCRIPTION TRANSLATOR ═══════════════════════ */
function loadSample() {
  document.getElementById('trans-input').value = PRESCRIPTION_SAMPLES[0];
}

function parseEntry(line) {
  // Extract drug type, name, dose, frequency, timing from a line
  const freq = Object.keys(ABBREV).find(k => line.includes(k) && ['OD','BD','TDS','QID','SOS'].includes(k));
  const timing = Object.keys(ABBREV).find(k => line.includes(k) && ['AC','PC','HS','SC','IV','IM'].includes(k));
  const doseMatch = line.match(/(\d+(?:\.\d+)?)\s*(mg|ml|IU|U|mcg)/i);
  const typeMatch = line.match(/^(Tab\.|Cap\.|Syp\.|Inj\.)\s*/);
  const nameMatch = line.replace(/^(Tab\.|Cap\.|Syp\.|Inj\.)\s*/,'').split(/\s+/)[0];
  return {
    type:   typeMatch ? ABBREV[typeMatch[0].trim()] || typeMatch[0] : 'Medicine',
    name:   nameMatch || 'Unknown',
    dose:   doseMatch ? doseMatch[0] : '–',
    freq:   ABBREV[freq] || freq || '–',
    timing: ABBREV[timing] || timing || '–'
  };
}

function translatePrescription() {
  const raw  = document.getElementById('trans-input').value.trim();
  if (!raw) { alert('Please enter a prescription or click Load Sample.'); return; }

  const lang = selectedTransLang;
  const t    = TRANS[lang];

  // Parse lines
  const lines = raw.split('.').map(l => l.trim()).filter(l => l.length > 3);

  lastTransData = { lines, lang };
  simplerMode = false;
  document.getElementById('tog-sw').classList.remove('on');

  renderTransOutput(lines, lang, false);

  document.getElementById('trans-output-wrap').style.display = 'block';
  document.getElementById('trans-placeholder').style.display  = 'none';
}

function renderTransOutput(lines, lang, simpler) {
  const t = TRANS[lang];
  let html = `<p style="font-size:.88rem;color:var(--text-soft);margin-bottom:16px">${simpler ? t.understand_q : t.intro}</p>`;

  lines.forEach((line, i) => {
    const entry = parseEntry(line);
    if (simpler) {
      html += `
      <div class="step-item">
        <div class="step-num">${i+1}</div>
        <div>
          <strong>${entry.name}</strong><br>
          <span style="font-size:.82rem;color:var(--text-soft)">
            ${lang === 'ta' ? `${entry.dose} — ${entry.freq} — ${entry.timing}` :
              lang === 'hi' ? `${entry.dose} — ${entry.freq} — ${entry.timing}` :
              `Take ${entry.dose}, ${entry.freq}, ${entry.timing}`}
          </span>
        </div>
      </div>`;
    } else {
      html += `
      <div class="step-item">
        <div class="step-num">${i+1}</div>
        <div>
          <span class="highlight-pill pill-med">${t.labels.med}: ${entry.name}</span>
          <span class="highlight-pill pill-dose">${t.labels.dose}: ${entry.dose}</span>
          <span class="highlight-pill pill-time">${t.labels.time}: ${entry.timing}</span>
          <br><span style="font-size:.8rem;color:var(--text-soft);display:block;margin-top:4px">
            ${entry.freq}
          </span>
        </div>
      </div>`;
    }
  });

  document.getElementById('trans-output').innerHTML = html;
}

function toggleSimpler() {
  simplerMode = !simplerMode;
  document.getElementById('tog-sw').classList.toggle('on', simplerMode);
  if (lastTransData) {
    renderTransOutput(lastTransData.lines, lastTransData.lang, simplerMode);
  }
}
