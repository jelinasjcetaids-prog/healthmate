
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HealthMate — Your Inclusive Health Companion</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet"/>
  <style>
    /* ─── CSS VARIABLES ─────────────────────────────────────── */
    :root {
      --primary:    #1A6FBF;
      --primary-dk: #0f4e8a;
      --accent:     #00C9A7;
      --accent2:    #FF6B6B;
      --bg:         #F4F8FF;
      --surface:    #FFFFFF;
      --surface2:   #EAF2FF;
      --text:       #1C2B3A;
      --text-soft:  #5A7390;
      --border:     #D6E4F5;
      --shadow:     0 4px 28px rgba(26,111,191,.10);
      --radius:     16px;
      --transition: .28s cubic-bezier(.4,0,.2,1);
    }

    /* ─── RESET & BASE ─────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }
    h1,h2,h3,h4 { font-family: 'DM Serif Display', serif; line-height: 1.25; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; }

    /* ─── SCROLLBAR ─────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 7px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 99px; }

    /* ─── UTILITY ───────────────────────────────────────────── */
    .section-label {
      display: inline-block;
      background: var(--surface2);
      color: var(--primary);
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 99px;
      margin-bottom: 14px;
    }
    .section-title { font-size: clamp(1.6rem,3.5vw,2.5rem); color: var(--text); }
    .section-sub   { color: var(--text-soft); font-size: 1rem; max-width: 560px; }
    .btn-primary-custom {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 13px 30px;
      border-radius: 12px;
      font-weight: 600;
      font-size: .95rem;
      cursor: pointer;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-primary-custom:hover { background: var(--primary-dk); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(26,111,191,.25); color: #fff; }
    .btn-accent-custom {
      background: var(--accent);
      color: #fff;
      border: none;
      padding: 13px 30px;
      border-radius: 12px;
      font-weight: 600;
      font-size: .95rem;
      cursor: pointer;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-accent-custom:hover { background: #00a88d; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,201,167,.25); }
    .card-glass {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      transition: var(--transition);
    }
    .card-glass:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(26,111,191,.14); }
    .fade-in { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
    .fade-in.visible { opacity: 1; transform: none; }

    /* ─── NAV ───────────────────────────────────────────────── */
    .navbar-custom {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      background: rgba(255,255,255,.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: 14px 0;
      transition: var(--transition);
    }
    .navbar-custom .brand {
      font-family: 'DM Serif Display', serif;
      font-size: 1.5rem;
      color: var(--primary);
      display: flex; align-items: center; gap: 8px;
    }
    .brand-dot { width: 9px; height: 9px; background: var(--accent); border-radius: 50%; display: inline-block; }
    .nav-link-custom {
      color: var(--text-soft);
      font-weight: 500;
      font-size: .9rem;
      padding: 6px 14px;
      border-radius: 8px;
      transition: var(--transition);
    }
    .nav-link-custom:hover, .nav-link-custom.active { color: var(--primary); background: var(--surface2); }
    .lang-btn {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 5px 12px;
      font-size: .82rem;
      font-weight: 600;
      color: var(--primary);
      cursor: pointer;
      transition: var(--transition);
    }
    .lang-btn.active { background: var(--primary); color: #fff; }
    .lang-btn:hover { background: var(--primary); color: #fff; }

    /* ─── HERO ──────────────────────────────────────────────── */
    #hero {
      min-height: 100vh;
      padding-top: 90px;
      background:
        radial-gradient(ellipse 80% 60% at 70% 20%, rgba(26,111,191,.09) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 20% 80%, rgba(0,201,167,.07) 0%, transparent 55%),
        var(--bg);
      display: flex; align-items: center;
      position: relative; overflow: hidden;
    }
    .hero-badge {
      background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 100%);
      color: #fff;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .08em;
      padding: 5px 16px;
      border-radius: 99px;
      display: inline-block;
      margin-bottom: 20px;
    }
    .hero-title { font-size: clamp(2.2rem,5.5vw,3.8rem); color: var(--text); line-height: 1.15; }
    .hero-title span { color: var(--primary); }
    .hero-sub { font-size: 1.1rem; color: var(--text-soft); margin: 20px 0 36px; max-width: 540px; }
    .hero-stats { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 44px; }
    .stat-box { text-align: center; }
    .stat-num { font-family: 'DM Serif Display', serif; font-size: 2rem; color: var(--primary); }
    .stat-lbl { font-size: .78rem; color: var(--text-soft); font-weight: 600; letter-spacing: .05em; }
    .hero-visual {
      position: relative;
      display: flex; align-items: center; justify-content: center;
    }
    .hero-card-float {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 20px;
      padding: 22px 26px;
      box-shadow: var(--shadow);
      animation: float 4s ease-in-out infinite;
      max-width: 280px;
    }
    .hero-card-float:nth-child(2) { animation-delay: -2s; margin-top: 28px; }
    @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
    .pulse-dot {
      width: 10px; height: 10px;
      background: var(--accent);
      border-radius: 50%;
      display: inline-block;
      animation: pulse 1.5s ease infinite;
    }
    @keyframes pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.5);opacity:.6} }
    .health-ring {
      width: 200px; height: 200px;
      border-radius: 50%;
      background: conic-gradient(var(--accent) 0% 72%, var(--border) 72%);
      display: flex; align-items: center; justify-content: center;
      position: relative; margin: 0 auto;
    }
    .health-ring::before {
      content: '';
      position: absolute; inset: 14px;
      background: var(--surface);
      border-radius: 50%;
    }
    .ring-inner { position: relative; z-index: 1; text-align: center; }
    .ring-score { font-family: 'DM Serif Display', serif; font-size: 2.8rem; color: var(--primary); }

    /* ─── LANGUAGE BAR ──────────────────────────────────────── */
    .lang-bar {
      background: linear-gradient(90deg, var(--primary) 0%, #1d7dd6 100%);
      padding: 12px 0;
      color: #fff;
      font-size: .88rem;
    }
    .lang-pill {
      background: rgba(255,255,255,.18);
      border: 1px solid rgba(255,255,255,.3);
      color: #fff;
      border-radius: 99px;
      padding: 4px 14px;
      font-size: .82rem;
      cursor: pointer;
      transition: var(--transition);
    }
    .lang-pill:hover, .lang-pill.active { background: #fff; color: var(--primary); }

    /* ─── FEATURES ──────────────────────────────────────────── */
    #features { padding: 96px 0; }
    .feat-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 32px 28px;
      height: 100%;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }
    .feat-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      transform: scaleX(0);
      transition: var(--transition);
    }
    .feat-card:hover { transform: translateY(-6px); box-shadow: 0 16px 48px rgba(26,111,191,.13); }
    .feat-card:hover::before { transform: scaleX(1); }
    .feat-icon {
      width: 54px; height: 54px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
      margin-bottom: 18px;
    }

    /* ─── TABS NAV ──────────────────────────────────────────── */
    #tools { padding: 96px 0; background: var(--surface); }
    .tool-tabs {
      display: flex; gap: 10px; flex-wrap: wrap;
      border-bottom: 2px solid var(--border);
      padding-bottom: 0; margin-bottom: 40px;
    }
    .tool-tab {
      padding: 12px 22px;
      border-radius: 12px 12px 0 0;
      border: 2px solid transparent;
      border-bottom: none;
      font-weight: 600;
      font-size: .92rem;
      cursor: pointer;
      color: var(--text-soft);
      background: transparent;
      transition: var(--transition);
      display: flex; align-items: center; gap: 8px;
      position: relative;
      bottom: -2px;
    }
    .tool-tab.active {
      color: var(--primary);
      border-color: var(--border);
      border-bottom-color: var(--surface);
      background: var(--surface);
    }
    .tool-tab:hover:not(.active) { color: var(--primary); background: var(--surface2); }
    .tool-panel { display: none; }
    .tool-panel.active { display: block; animation: fadeUp .4s ease; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:none} }

    /* ─── TOOL 1: HEALTH TIME MACHINE ───────────────────────── */
    .slider-wrap label { font-weight: 600; font-size: .9rem; color: var(--text); }
    .slider-val {
      background: var(--primary);
      color: #fff;
      border-radius: 8px;
      padding: 2px 10px;
      font-size: .82rem;
      font-weight: 700;
    }
    input[type=range] {
      width: 100%;
      accent-color: var(--primary);
      height: 6px;
    }
    .radio-group { display: flex; flex-wrap: wrap; gap: 8px; }
    .radio-btn {
      padding: 7px 16px;
      border: 1.5px solid var(--border);
      border-radius: 99px;
      font-size: .85rem;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      background: var(--bg);
      color: var(--text-soft);
    }
    .radio-btn.selected { border-color: var(--primary); background: var(--surface2); color: var(--primary); }
    .score-card {
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      text-align: center;
    }
    .score-big { font-family: 'DM Serif Display', serif; font-size: 3.2rem; line-height: 1; }
    .progress-bar-custom {
      height: 10px; border-radius: 99px;
      background: var(--border); overflow: hidden;
    }
    .progress-fill {
      height: 100%; border-radius: 99px;
      transition: width 1s cubic-bezier(.4,0,.2,1);
    }
    .risk-badge {
      display: inline-block;
      padding: 4px 16px;
      border-radius: 99px;
      font-weight: 700;
      font-size: .82rem;
    }
    .risk-low    { background: #d4f7ee; color: #0a7a5b; }
    .risk-medium { background: #fff3cd; color: #8a6200; }
    .risk-high   { background: #fde8e8; color: #b91c1c; }
    .tip-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 10px 14px;
      background: var(--bg);
      border-radius: 10px;
      font-size: .88rem;
      margin-bottom: 8px;
    }
    .tip-icon { color: var(--accent); font-size: 1rem; flex-shrink: 0; margin-top: 2px; }

    /* ─── TOOL 2: SYMPTOM CHECKER ───────────────────────────── */
    .symptom-chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 16px;
      border: 1.5px solid var(--border);
      border-radius: 99px;
      font-size: .85rem;
      cursor: pointer;
      transition: var(--transition);
      background: var(--bg);
      color: var(--text-soft);
      user-select: none;
    }
    .symptom-chip.selected { border-color: var(--primary); background: var(--surface2); color: var(--primary); }
    .symptom-chip:hover { border-color: var(--primary); color: var(--primary); }
    .diagnosis-card {
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      margin-bottom: 12px;
      transition: var(--transition);
    }
    .diagnosis-card:hover { box-shadow: var(--shadow); }
    .action-emergency { color: #b91c1c; background: #fde8e8; border-color: #fca5a5; }
    .action-doctor    { color: #92400e; background: #fef3c7; border-color: #fcd34d; }
    .action-self      { color: #065f46; background: #d1fae5; border-color: #6ee7b7; }

    /* ─── TOOL 3: HEALTH TRANSLATOR ─────────────────────────── */
    .translator-input {
      width: 100%;
      min-height: 120px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      font-family: 'DM Sans', sans-serif;
      font-size: .92rem;
      resize: vertical;
      transition: var(--transition);
      background: var(--bg);
      color: var(--text);
    }
    .translator-input:focus { outline: none; border-color: var(--primary); background: var(--surface); }
    .trans-output {
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      min-height: 140px;
    }
    .highlight-pill {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 6px;
      font-weight: 700;
      font-size: .8rem;
      margin: 2px;
    }
    .pill-med  { background: #dbeafe; color: #1d4ed8; }
    .pill-dose { background: #d1fae5; color: #065f46; }
    .pill-time { background: #fef3c7; color: #92400e; }
    .step-item {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 12px;
      border-bottom: 1px solid var(--border);
    }
    .step-num {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--primary); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: .78rem; font-weight: 700; flex-shrink: 0;
    }
    .understand-toggle {
      display: flex; align-items: center; gap: 10px;
      background: var(--surface2);
      border-radius: 12px;
      padding: 12px 18px;
      cursor: pointer;
      font-weight: 600;
      font-size: .88rem;
      color: var(--primary);
    }
    .toggle-switch {
      width: 40px; height: 22px;
      background: var(--border);
      border-radius: 99px; position: relative;
      transition: var(--transition);
    }
    .toggle-switch.on { background: var(--accent); }
    .toggle-knob {
      position: absolute; top: 3px; left: 3px;
      width: 16px; height: 16px; border-radius: 50%;
      background: #fff; transition: var(--transition);
    }
    .toggle-switch.on .toggle-knob { left: 21px; }

    /* ─── ABOUT / INCLUSIVITY ───────────────────────────────── */
    #about { padding: 96px 0; }
    .inclusion-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 28px;
      text-align: center;
      height: 100%;
      transition: var(--transition);
    }
    .inclusion-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }

    /* ─── TESTIMONIALS ──────────────────────────────────────── */
    #testimonials { padding: 80px 0; background: var(--surface); }
    .testi-card {
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 28px;
      height: 100%;
    }
    .stars { color: #f59e0b; font-size: .9rem; }
    .avatar-circle {
      width: 42px; height: 42px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: .9rem; color: #fff;
    }

    /* ─── FOOTER ────────────────────────────────────────────── */
    footer {
      background: var(--text);
      color: rgba(255,255,255,.75);
      padding: 56px 0 28px;
    }
    footer .brand { color: #fff; }
    .footer-link { color: rgba(255,255,255,.6); font-size: .88rem; display: block; margin-bottom: 8px; transition: var(--transition); }
    .footer-link:hover { color: var(--accent); }
    .footer-divider { border-color: rgba(255,255,255,.1); margin: 28px 0 20px; }
    .social-btn {
      width: 36px; height: 36px; border-radius: 9px;
      background: rgba(255,255,255,.1);
      display: inline-flex; align-items: center; justify-content: center;
      color: #fff; font-size: .95rem;
      transition: var(--transition);
    }
    .social-btn:hover { background: var(--primary); color: #fff; }

    /* ─── MOBILE NAV TOGGLE ─────────────────────────────────── */
    .nav-toggler {
      background: var(--surface2); border: none; border-radius: 8px;
      padding: 7px 10px; color: var(--primary); font-size: 1.1rem; cursor: pointer;
    }
    .nav-mobile {
      display: none; flex-direction: column; gap: 6px;
      padding: 16px; background: var(--surface);
      border-top: 1px solid var(--border);
    }
    .nav-mobile.open { display: flex; }

    /* ─── EMERGENCY BANNER ──────────────────────────────────── */
    .emergency-bar {
      background: var(--accent2);
      color: #fff;
      text-align: center;
      padding: 9px;
      font-size: .83rem;
      font-weight: 600;
    }
    .emergency-bar a { color: #fff; font-weight: 700; text-decoration: underline; }

    /* ─── RESPONSIVE ────────────────────────────────────────── */
    @media(max-width:768px){
      .hero-stats { gap: 20px; }
      .tool-tabs { gap: 6px; }
      .tool-tab { padding: 9px 13px; font-size: .82rem; }
      .nav-links-desktop { display: none !important; }
    }
    @media(min-width:769px){
      .nav-toggler { display: none; }
    }

    /* ─── LOADING SPINNER ───────────────────────────────────── */
    .spinner {
      width: 20px; height: 20px;
      border: 2.5px solid rgba(255,255,255,.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .7s linear infinite;
      display: inline-block;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ─── ACTIVE SECTION HIGHLIGHT ──────────────────────────── */
    .section-wave {
      width: 100%; overflow: hidden; line-height: 0;
    }
    .section-wave svg { display: block; }
  </style>
</head>
<body>

<!-- ═══ EMERGENCY BAR ════════════════════════════════════════ -->
<div class="emergency-bar">
  🚨 Emergency? Call <a href="tel:108">108</a> (Ambulance) &nbsp;|&nbsp; <a href="tel:104">104</a> (Health Helpline) &nbsp;|&nbsp; <a href="tel:100">100</a> (Police)
</div>

<!-- ═══ NAVBAR ════════════════════════════════════════════════ -->
<nav class="navbar-custom">
  <div class="container d-flex align-items-center justify-content-between">
    <a href="#hero" class="brand">
      <i class="bi bi-heart-pulse-fill" style="color:var(--accent)"></i>
      HealthMate <span class="brand-dot"></span>
    </a>
    <!-- Desktop links -->
    <div class="d-flex align-items-center gap-2 nav-links-desktop">
      <a href="#hero"         class="nav-link-custom active">Home</a>
      <a href="#features"     class="nav-link-custom">Features</a>
      <a href="#tools"        class="nav-link-custom">Tools</a>
      <a href="#about"        class="nav-link-custom">About</a>
      <a href="#testimonials" class="nav-link-custom">Reviews</a>
    </div>
    <div class="d-flex align-items-center gap-2">
      <!-- Language switcher -->
      <button class="lang-btn active" data-lang="en" onclick="setLang('en')">EN</button>
      <button class="lang-btn" data-lang="ta" onclick="setLang('ta')">தமிழ்</button>
      <button class="lang-btn" data-lang="hi" onclick="setLang('hi')">हिंदी</button>
      <button class="nav-toggler d-md-none" onclick="toggleMobileNav()"><i class="bi bi-list"></i></button>
    </div>
  </div>
  <!-- Mobile nav -->
  <div class="nav-mobile" id="mobileNav">
    <a href="#hero"         class="nav-link-custom" onclick="closeMobileNav()">Home</a>
    <a href="#features"     class="nav-link-custom" onclick="closeMobileNav()">Features</a>
    <a href="#tools"        class="nav-link-custom" onclick="closeMobileNav()">Tools</a>
    <a href="#about"        class="nav-link-custom" onclick="closeMobileNav()">About</a>
    <a href="#testimonials" class="nav-link-custom" onclick="closeMobileNav()">Reviews</a>
  </div>
</nav>

<!-- ═══ HERO ══════════════════════════════════════════════════ -->
<section id="hero">
  <div class="container py-5">
    <div class="row align-items-center g-5">
      <!-- Left -->
      <div class="col-lg-6 fade-in">
        <div class="hero-badge">✦ Inclusive · Preventive · Accessible</div>
        <h1 class="hero-title">
          Your Smart<br><span>Health Support</span><br>Companion
        </h1>
        <p class="hero-sub" id="hero-sub-text">
          Empowering patients, caregivers, elderly users, and busy professionals with AI-powered health tools — in English, Tamil, and Hindi.
